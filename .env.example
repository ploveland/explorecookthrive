# PostgreSQL
DATABASE_URL="postgresql://ect:ect@localhost:5433/explore_cook_thrive"

# LLM — OpenAI is the default provider. Anthropic is reserved.
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Optional. Pause between conversion stages so the working page can be read.
CONVERT_STAGE_DELAY_MS="350"

# USDA FoodData Central (Phase 4)
USDA_FDC_API_KEY=""

# Auth.js (Phase 6). Required in production. Local fallback is used if empty.
AUTH_SECRET="replace-me-with-a-long-random-string"
# AUTH_URL="http://localhost:43123"

# Canonical site URL for sitemap, robots, and Recipe JSON-LD (Phase 7).
# On Render, APP_URL/AUTH_URL can be omitted at first; RENDER_EXTERNAL_URL is used.
# APP_URL="http://localhost:43123"
# AUTH_URL="http://localhost:43123"
